<Window x:Class="JxrConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JXR → PNG Converter"
        Height="720" Width="800"
        MinHeight="520" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f14"
        Foreground="#e4e4ef"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <Color x:Key="BgPrimary">#0f0f14</Color>
        <Color x:Key="BgSecondary">#16161e</Color>
        <Color x:Key="BgTertiary">#1e1e2a</Color>
        <Color x:Key="BgHover">#262636</Color>
        <Color x:Key="Accent">#7c6aef</Color>
        <Color x:Key="AccentHover">#9585f5</Color>
        <Color x:Key="TextPrimary">#e4e4ef</Color>
        <Color x:Key="TextSecondary">#8888a0</Color>
        <Color x:Key="TextDim">#55556a</Color>
        <Color x:Key="Success">#4ade80</Color>
        <Color x:Key="Error">#f87171</Color>
        <Color x:Key="Warning">#fbbf24</Color>
        <Color x:Key="Border">#2a2a3d</Color>

        <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimary}"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondary}"/>
        <SolidColorBrush x:Key="BgTertiaryBrush" Color="{StaticResource BgTertiary}"/>
        <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#33335a"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#55556a"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgTertiaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#3d1f1f"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="JXR" FontFamily="Segoe UI Black" FontSize="28"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="  →  " FontSize="28" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Segoe UI Light"/>
                <TextBlock Text="PNG" FontFamily="Segoe UI Black" FontSize="28"
                           Foreground="{StaticResource SuccessBrush}"/>
            </StackPanel>
            <TextBlock Text="Convert HDR JPEG XR screenshots to HDR PNG format"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontFamily="Segoe UI" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource BorderBrush}" Margin="32,0"/>

        <Grid Grid.Row="2" Margin="32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="AddFilesBtn" Grid.Column="0" Content="＋  Add Files"
                    Style="{StaticResource AccentButton}" Click="AddFiles_Click"
                    FontSize="12" Padding="20,9"/>
            <Button x:Name="ClearAllBtn" Grid.Column="1" Content="Clear All"
                    Style="{StaticResource SubtleButton}" Click="ClearAll_Click"
                    Margin="10,0,0,0"/>
            <TextBlock x:Name="FileCountLabel" Grid.Column="3"
                       Text="0 files selected" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}"
                       FontFamily="Segoe UI" FontSize="12"/>
        </Grid>

        <Border Grid.Row="3" Margin="32,0" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="{StaticResource BgSecondaryBrush}">
            <Grid>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📁" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="No files added yet" FontFamily="Segoe UI Semibold" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click &quot;Add Files&quot; or drag &amp; drop .jxr files here"
                               Foreground="{StaticResource TextDimBrush}" FontFamily="Segoe UI" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <ScrollViewer x:Name="FileListScroller" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Background="{StaticResource BgTertiaryBrush}"
                                        CornerRadius="8" Margin="6,3" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontFamily="Segoe UI Semibold"
                                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Directory}" FontSize="10"
                                                           Foreground="{StaticResource TextDimBrush}" MaxWidth="380"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="10"
                                                           Foreground="{StaticResource TextDimBrush}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontFamily="Segoe UI" FontSize="11"
                                                   VerticalAlignment="Center" Margin="12,0"/>

                                        <Button Grid.Column="2" Content="✕"
                                                Style="{StaticResource RemoveButton}"
                                                Click="RemoveFile_Click"
                                                Tag="{Binding FilePath}"
                                                Visibility="{Binding RemoveVisibility}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#262636"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="32,12,32,0">
            <Border Background="#1a1a28" CornerRadius="3" Height="6" Margin="0,0,0,6">
                <Border x:Name="ProgressBar" Background="{StaticResource AccentBrush}"
                        CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
            </Border>
            <TextBlock x:Name="ProgressLabel" Text="" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="32,12,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Output: " Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Segoe UI" FontSize="11"/>
                <TextBlock x:Name="OutputPathLabel" Text="Converted PNGs\"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" FontSize="11"/>
            </StackPanel>

            <Button x:Name="OpenFolderBtn" Grid.Column="1" Content="Open Folder"
                    Style="{StaticResource SubtleButton}" Click="OpenFolder_Click"
                    Visibility="Collapsed" Margin="0,0,10,0" Padding="16,9"/>

            <Button x:Name="ConvertBtn" Grid.Column="2" Content="Convert All"
                    Style="{StaticResource AccentButton}" Click="Convert_Click"
                    IsEnabled="False" Padding="28,11" FontSize="14"/>
        </Grid>
    </Grid>
</Window>
